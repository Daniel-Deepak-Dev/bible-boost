{
  "manifest_version": 3,
  "name": "BibleBoost — Power-ups for Bible.com",
  "short_name": "BibleBoost",
  "version": "2.2.0",
  "description": "Power-ups for Bible.com. Starts with parallel reading: two versions side by side, verses lined up. Keeps highlight, copy and share.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BibleBoost",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bible.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
