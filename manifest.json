{
  "manifest_version": 3,
  "name": "BibleBoost — Bible Reading Enhancer",
  "short_name": "BibleBoost",
  "version": "2.3.0",
  "description": "Enhances Bible reading on bible.com. Read two versions side by side with every verse lined up, plus optional verse separators.",
  "homepage_url": "https://github.com/Daniel-Deepak-Dev/bible-boost",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BibleBoost",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-parallel": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Toggle parallel mode"
    },
    "toggle-align": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Line up verses side by side"
    },
    "toggle-separators": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Show or hide verse separators"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bible.com/*"
      ],
      "js": [
        "src/content/bible-dom.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
